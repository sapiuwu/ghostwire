{
  "name": "ghostwire",
  "version": "0.1.0",
  "description": "Hexagonal-architecture remote desktop CLI for Windows (custom RDP-like protocol over TCP)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ghostwire": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.2"
  }
}
